---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - 页面不存在" description="你要找的页面不存在">
	<div class="nf-wrap">
		<div class="nf-code">404</div>
		<div class="nf-msg">页面不存在或已被移动</div>
		<a class="nf-btn" href="/">返回首页</a>
	</div>
</Layout>

<style>
	.nf-wrap {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 16px;
		padding: 96px 0 128px;
		text-align: center;
	}
	.nf-code {
		font-size: 120px;
		font-weight: 900;
		line-height: 1;
		letter-spacing: -0.04em;
		background: linear-gradient(120deg, #a5b4fc, #f0abfc);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		text-shadow: 0 0 60px rgba(194, 65, 12, 0.22);
	}
	.nf-msg {
		color: var(--text-mute);
		font-size: 15px;
		font-weight: 600;
		letter-spacing: 0.1em;
	}
	.nf-btn {
		display: inline-block;
		margin-top: 12px;
		padding: 12px 36px;
		border-radius: 999px;
		background: linear-gradient(120deg, var(--indigo, #c2410c), var(--purple, #d97706));
		color: #fff;
		font-size: 15px;
		font-weight: 700;
		text-decoration: none;
		box-shadow: 0 10px 20px -6px rgba(194, 65, 12, 0.4);
		transition: transform 0.25s;
	}
	.nf-btn:hover {
		transform: translateY(-2px);
	}
</style>