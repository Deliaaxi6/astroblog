---
/**
 * 光影画廊 · 相册详情页（admin/gallery/[id]）
 *
 * 相册信息 + 照片网格（静态渲染，Image 优化懒加载）
 * 批量上传照片（AlbumUpload island）
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import '../../../styles/global.css';
import GalleryParticles from '../../../components/gallery/GalleryParticles.astro';
import AlbumUpload from '../../../components/gallery/AlbumUpload.astro';

export async function getStaticPaths() {
	const albums = await getCollection('albums');
	return albums.map((album) => ({
		params: { id: album.data.id },
		props: { album },
	}));
}

const { album } = Astro.props;
const { title, description, createdAt, cover, photos } = album.data;
---

<!DOCTYPE html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title} · 光影画廊</title>
	</head>
	<body class="gallery-body">
		<GalleryParticles />

		<main class="gallery-detail">
			<a class="back-link" href="/admin/gallery">← 返回画廊</a>

			<header class="detail-head">
				<h1 class="detail-title">{title}</h1>
				{
					description && <p class="detail-desc">{description}</p>
				}
				<p class="detail-date">{createdAt}</p>
			</header>

			<div class="detail-cover">
				<Image src={cover} alt={title} format="webp" loading="lazy" />
			</div>

			<AlbumUpload albumId={album.data.id} />

			{
				photos.length > 0 ? (
					<div class="photo-grid">
						{
							photos.map((photo) => (
								<Image src={photo} alt={title} class="photo-item" format="webp" loading="lazy" />
							))
						}
					</div>
				) : (
					<p class="photo-empty">这个相册还没有照片，使用上方按钮批量上传。</p>
				)
			}
		</main>
	</body>
</html>

<style is:global>
	.gallery-body {
		min-height: 100vh;
		margin: 0;
		background: linear-gradient(165deg, #0b0716 0%, #1a1033 46%, #0d0819 100%);
		background-attachment: fixed;
		color: #e8e4ff;
		font-family: system-ui, -apple-system, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
	}

	.gallery-detail {
		position: relative;
		z-index: 1;
		max-width: 1080px;
		margin: 0 auto;
		padding: 44px 32px 72px;
	}

	.back-link {
		display: inline-block;
		margin-bottom: 26px;
		color: rgba(216, 210, 255, 0.6);
		font-size: 13px;
		text-decoration: none;
		transition: color 0.2s;
	}
	.back-link:hover {
		color: #fff;
	}

	.detail-title {
		margin: 0 0 10px;
		font-size: 34px;
		letter-spacing: 4px;
		background: linear-gradient(120deg, #fff 10%, #c4b5fd 55%, #8b5cf6 90%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
	.detail-desc {
		margin: 0 0 8px;
		font-size: 14px;
		color: rgba(216, 210, 255, 0.65);
		line-height: 1.8;
	}
	.detail-date {
		margin: 0 0 26px;
		font-size: 12px;
		color: rgba(216, 210, 255, 0.4);
		letter-spacing: 1px;
	}

	.detail-cover {
		margin-bottom: 28px;
		border-radius: 16px;
		overflow: hidden;
		border: 1px solid rgba(167, 139, 250, 0.22);
		box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55);
	}
	.detail-cover img {
		display: block;
		width: 100%;
		height: auto;
	}

	.photo-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 18px;
		margin-top: 28px;
	}
	.photo-item {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: 12px;
		border: 1px solid rgba(167, 139, 250, 0.16);
		box-shadow: 0 10px 28px rgba(0, 0, 0, 0.4);
		transition: transform 0.25s;
	}
	.photo-item:hover {
		transform: scale(1.025);
	}

	.photo-empty {
		margin-top: 32px;
		font-size: 13px;
		color: rgba(216, 210, 255, 0.45);
	}

	@media (max-width: 720px) {
		.gallery-detail {
			padding: 32px 20px 56px;
		}
		.photo-grid {
			grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
			gap: 12px;
		}
	}
</style>