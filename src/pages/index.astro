---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { site } from '../lib/site';
import { musicIds } from '../data/music';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const formatter = new Intl.DateTimeFormat('zh-CN', {
	year: 'numeric',
	month: '2-digit',
	day: '2-digit',
});

const monthFormatter = new Intl.DateTimeFormat('zh-CN', {
	year: 'numeric',
	month: '2-digit',
});

const searchData = posts.map((p) => ({
	slug: p.id,
	title: p.data.title,
	desc: p.data.description ?? '',
	date: formatter.format(p.data.pubDate),
	tags: p.data.tags ?? [],
}));

const chatters = (await getCollection('moments'))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.map((m) => {
		const body = (m.body ?? '').trim().replace(/\r\n/g, '\n');
		const firstLine = body.split('\n').find((l) => l.trim()) ?? '一条新的说说';
		return {
			title: firstLine.slice(0, 48),
			date: formatter.format(m.data.date),
		};
	});

const latestChatter = chatters[0] ?? null;

const archives = posts.reduce((acc, p) => {
	const key = monthFormatter.format(p.data.pubDate);
	const hit = acc.find((a) => a.key === key);
	if (hit) hit.count++;
	else acc.push({ key, count: 1 });
	return acc;
}, []);

const buildDate = new Date().toISOString().slice(0, 10);
const buildStamp = '2026-08-14T00:00:00';
const lead = posts[0] ?? null;
---

<Layout title="纸上拾光">
	<!-- 搜索弹层 -->
	<div class="search-overlay" id="searchOverlay" hidden>
		<form class="search-box" onsubmit="return false;">
			<input
				class="search-input"
				id="searchInput"
				type="text"
				placeholder="搜寻标题、描述或标签…"
				autocomplete="off"
			/>
			<svg
				class="search-icon"
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2.5"
				stroke-linecap="round"
				stroke-linejoin="round"
				width="18"
				height="18"
			>
				<circle cx="11" cy="11" r="8"></circle>
				<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
			</svg>
		</form>
		<div class="search-results" id="searchResults"></div>
	</div>

	<!-- 刊头（档案 masthead） -->
	<header class="masthead">
		<div class="mast-name">
			纸上拾光<span class="mast-sub">/ 档案目录 NO.001</span>
		</div>
		<div class="mast-actions">
			<button class="icon-btn" id="searchBtn" title="搜索">搜</button>
			<button class="icon-btn" id="themeBtn" title="切换主题"><span id="themeIcon">☾</span></button>
		</div>
	</header>

	<!-- 卷宗抬头条 -->
	<div class="issue">
		<span class="issue-no">VOL.001 · 建档</span>
		<span class="issue-date">建档于 {buildDate}</span>
		<span class="issue-file">FILE {String(posts.length).padStart(3, '0')} 篇收录</span>
	</div>

	<!-- 主布局：左文右栏 -->
	<div class="layout">
		<main class="main">
			{lead ? (
				<article class="lead">
					<div class="lead-kicker">LEAD · 本期头条</div>
					<h2 class="lead-title"><span class="hl">{lead.data.title}</span></h2>
					<p class="lead-lede">{lead.data.description}</p>
					<span class="lead-meta">
						{formatter.format(lead.data.pubDate)}
						{lead.data.tags?.length ? ` · ${lead.data.tags.join(' / ')}` : ''}
					</span>
					<a class="lead-link" href={`/blog/${lead.id}`}>展开卷宗 →</a>
				</article>
			) : (
				<article class="lead">
					<h2 class="lead-title">卷宗尚空</h2>
					<p class="lead-lede">还没有收录任何文章。</p>
				</article>
			)}

			<!-- 文章列表（极简：标题+日期） -->
			<section class="posts">
				<h3 class="sec-title">— 新收文章 —</h3>
				{posts.slice(1).map((p, i) => (
					<a class="post" href={`/blog/${p.id}`}>
						<span class="post-no">{String(i + 2).padStart(2, '0')}</span>
						<span class="post-tt">{p.data.title}</span>
						<span class="post-dt">{formatter.format(p.data.pubDate)}</span>
					</a>
				))}
				{posts.length <= 1 && <p class="empty-tip">暂无更多文章</p>}
			</section>

			<!-- 编辑手记（最新说说单条引言） -->
			{latestChatter && (
				<section class="note">
					<span class="stamp">存档</span>
					<div class="note-body">
						<blockquote>{latestChatter.title}</blockquote>
						<cite>
							{latestChatter.date} · <a href="/moments">更多手记 →</a>
						</cite>
					</div>
				</section>
			)}
		</main>

		<aside class="side">
			<section class="side-sec">
				<h4 class="side-title">正在播放</h4>
				<div class="now-playing">
					<div class="eq" id="nowEq">♪</div>
					<div class="np-info">
						<div class="np-title" id="nowTitle">未连接云端</div>
						<div class="np-artist" id="nowArtist">—</div>
					</div>
				</div>
			</section>

			<section class="side-sec">
				<h4 class="side-title">按月归档</h4>
				<ul class="archive">
					{archives.map((a) => (
						<li>
							<a href="/timeline">
								<span>{a.key}</span>
								<span class="cnt">{a.count}</span>
							</a>
						</li>
					))}
				</ul>
			</section>

			<section class="side-sec">
				<h4 class="side-title">关于</h4>
				<p class="about-text">在代码、学术与日常之间穿梭的记录。站名暂定「纸上拾光」。</p>
				<a class="about-link" href="/about">关于本站 →</a>
			</section>
		</aside>
	</div>

	<!-- 底部迷你播放条 -->
	<div class="player" id="player">
		<div class="disc" id="disc">
			<img id="discImg" src="" alt="cover" />
			<div class="hole"></div>
		</div>
		<div class="player-info">
			<h3 class="player-title" id="playerTitle">未播放</h3>
			<span class="player-artist" id="playerArtist">—</span>
			<span class="player-lyric" id="playerLyric">云端未连接</span>
		</div>
		<div class="progress-row">
			<span class="t" id="curTime">00:00</span>
			<input type="range" class="seek" id="seekBar" min="0" max="100" value="0" />
			<span class="t2" id="durTime">00:00</span>
		</div>
		<div class="player-controls">
			<button class="ctrl-btn" id="prevBtn" title="上一首">
				<svg fill="currentColor" viewBox="0 0 24 24"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z" /></svg>
			</button>
			<button class="play-btn" id="playBtn" title="播放/暂停">
				<svg id="playIcon" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
			</button>
			<button class="ctrl-btn" id="nextBtn" title="下一首">
				<svg fill="currentColor" viewBox="0 0 24 24"><path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z" /></svg>
			</button>
		</div>
	</div>

	<style>
		/* ===== 档案 masthead ===== */
		.masthead {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 36px 0 18px;
			border-bottom: 2px solid var(--text-main);
		}
		.mast-name {
			font-family: var(--serif);
			font-size: 30px;
			font-weight: 900;
			letter-spacing: 0.08em;
		}
		.mast-sub {
			font-family: var(--mono);
			font-size: 12px;
			color: var(--text-mute);
			letter-spacing: 0.05em;
			margin-left: 10px;
		}
		.mast-actions {
			display: flex;
			gap: 10px;
		}
		.icon-btn {
			width: 34px;
			height: 34px;
			background: none;
			border: 1.5px solid var(--text-mute);
			color: var(--text-main);
			font-family: var(--mono);
			font-size: 13px;
			cursor: pointer;
			display: flex;
			align-items: center;
			justify-content: center;
			transition: border-color 0.25s, color 0.25s;
		}
		.icon-btn:hover {
			border-color: var(--seal);
			color: var(--seal);
		}

		/* ===== 卷宗抬头条 ===== */
		.issue {
			display: flex;
			justify-content: space-between;
			font-family: var(--mono);
			font-size: 11px;
			letter-spacing: 0.12em;
			color: var(--text-sub);
			padding: 8px 0;
			border-bottom: 1px solid var(--card-border);
		}
		.issue .issue-no {
			color: var(--seal);
		}

		/* ===== 布局 ===== */
		.layout {
			display: grid;
			grid-template-columns: 1fr 292px;
			gap: 48px;
			padding: 34px 0 80px;
		}
		@media (max-width: 860px) {
			.layout {
				grid-template-columns: 1fr;
				gap: 40px;
			}
			.side {
				position: static;
			}
		}

		/* ===== 头条 ===== */
		.lead {
			padding: 10px 0 28px;
			border-bottom: 1px solid var(--card-border);
		}
		.lead-kicker {
			font-family: var(--mono);
			font-size: 12px;
			letter-spacing: 0.2em;
			color: var(--seal);
		}
		.lead-title {
			font-family: var(--serif);
			font-size: clamp(26px, 3.6vw, 38px);
			font-weight: 900;
			line-height: 1.35;
			margin: 14px 0 10px;
			letter-spacing: 0.02em;
		}
		.hl {
			background: linear-gradient(transparent 62%, var(--hi) 62%, var(--hi) 96%, transparent 96%);
			padding: 0 2px;
		}
		.lead-lede {
			color: var(--text-sub);
			font-size: 15px;
			max-width: 60ch;
			margin-bottom: 8px;
		}
		.lead-meta {
			font-family: var(--mono);
			font-size: 12px;
			color: var(--text-mute);
		}
		.lead-link {
			display: inline-block;
			margin-top: 14px;
			font-size: 13px;
			font-weight: 700;
			color: var(--blue);
			text-decoration: none;
			border-bottom: 1px solid var(--blue);
			padding-bottom: 1px;
		}
		.lead-link:hover {
			color: var(--seal);
			border-color: var(--seal);
		}

		/* ===== 文章列表（档案行） ===== */
		.sec-title {
			font-family: var(--mono);
			font-size: 12px;
			letter-spacing: 0.24em;
			color: var(--text-sub);
			margin: 28px 0 4px;
		}
		.post {
			display: grid;
			grid-template-columns: 46px 1fr auto;
			gap: 14px;
			align-items: baseline;
			padding: 15px 10px 15px 16px;
			border-bottom: 1px solid var(--card-border);
			text-decoration: none;
			color: var(--text-main);
			border-left: 3px solid transparent;
			transition:
				transform 0.25s,
				border-color 0.25s,
				background 0.25s,
				box-shadow 0.25s;
		}
		.post:hover {
			transform: translateX(4px);
			border-left-color: var(--seal);
			background: rgba(35, 35, 43, 0.035);
			box-shadow: 3px 3px 0 rgba(35, 35, 43, 0.07);
		}
		[data-theme='dark'] .post:hover {
			background: rgba(230, 228, 221, 0.04);
			box-shadow: 3px 3px 0 rgba(230, 228, 221, 0.08);
		}
		.post-no {
			font-family: var(--mono);
			font-size: 12px;
			color: var(--blue);
		}
		.post-tt {
			font-weight: 800;
			font-size: 16px;
			letter-spacing: 0.02em;
		}
		.post-dt {
			font-family: var(--mono);
			font-size: 12px;
			color: var(--text-mute);
		}
		@media (max-width: 620px) {
			.post {
				grid-template-columns: 36px 1fr;
			}
			.post-dt {
				display: none;
			}
		}
		.empty-tip {
			font-size: 13px;
			color: var(--text-mute);
		}

		/* ===== 编辑手记（说说单条 + 存档章） ===== */
		.note {
			display: flex;
			gap: 18px;
			margin-top: 30px;
			padding: 18px 20px;
			background: var(--card-bg);
			border: 1px solid var(--card-border);
		}
		.stamp {
			flex: none;
			font-family: var(--mono);
			font-size: 11px;
			letter-spacing: 0.2em;
			color: var(--seal);
			border: 1.5px solid var(--seal);
			border-radius: 3px;
			padding: 3px 7px;
			transform: rotate(-8deg);
			height: fit-content;
			margin-top: 4px;
		}
		.note-body blockquote {
			margin: 0;
			font-family: var(--serif);
			font-size: 17px;
			line-height: 1.7;
		}
		.note-body cite {
			display: block;
			margin-top: 6px;
			font-style: normal;
			font-family: var(--mono);
			font-size: 11px;
			color: var(--text-mute);
		}
		.note-body cite a {
			color: var(--blue);
			text-decoration: none;
		}
		.note-body cite a:hover {
			color: var(--seal);
		}

		/* ===== 侧栏 ===== */
		.side {
			display: flex;
			flex-direction: column;
			gap: 30px;
			position: sticky;
			top: 84px;
			align-self: start;
		}
		.side-title {
			font-family: var(--mono);
			font-size: 12px;
			letter-spacing: 0.24em;
			color: var(--seal);
			margin: 0 0 10px;
			padding-bottom: 6px;
			border-bottom: 1px solid var(--card-border);
		}
		.now-playing {
			display: flex;
			align-items: center;
			gap: 12px;
		}
		.eq {
			font-size: 16px;
			color: var(--seal);
			animation: eqPulse 1.2s ease-in-out infinite;
		}
		.np-title {
			font-size: 14px;
			font-weight: 800;
		}
		.np-artist {
			font-size: 12px;
			color: var(--text-sub);
		}
		@keyframes eqPulse {
			0%,
			100% {
				opacity: 0.45;
			}
			50% {
				opacity: 1;
			}
		}
		.archive {
			list-style: none;
			margin: 0;
			padding: 0;
		}
		.archive a {
			display: flex;
			justify-content: space-between;
			padding: 7px 2px;
			border-bottom: 1px dashed var(--card-border);
			font-size: 13px;
			color: var(--text-main);
			text-decoration: none;
			transition: color 0.2s, padding-left 0.2s;
		}
		.archive a:hover {
			color: var(--seal);
			padding-left: 6px;
		}
		.archive .cnt {
			font-family: var(--mono);
			font-size: 11px;
			background: var(--hi);
			color: #23232b;
			padding: 0 6px;
			line-height: 1.7;
			border-radius: 2px;
		}
		.about-text {
			font-size: 13px;
			color: var(--text-sub);
			line-height: 1.8;
			margin: 0 0 8px;
		}
		.about-link {
			font-size: 12px;
			font-weight: 700;
			color: var(--blue);
			text-decoration: none;
		}
		.about-link:hover {
			color: var(--seal);
		}

		/* ===== 搜索弹层 ===== */
		.search-overlay {
			position: fixed;
			top: 74px;
			left: 50%;
			transform: translateX(-50%);
			width: min(560px, 92vw);
			z-index: 70;
		}
		.search-box {
			display: flex;
			align-items: center;
			gap: 10px;
			padding: 12px 16px;
			background: var(--card-bg);
			border: 2px solid var(--text-main);
			box-shadow: 4px 4px 0 rgba(35, 35, 43, 0.15);
		}
		.search-input {
			flex: 1;
			background: none;
			border: none;
			outline: none;
			font-size: 15px;
			color: var(--text-main);
			font-family: var(--sans);
		}
		.search-icon {
			color: var(--text-mute);
			flex: none;
		}
		.search-results {
			margin-top: 8px;
			background: var(--card-bg);
			border: 1px solid var(--card-border);
			box-shadow: 4px 4px 0 rgba(35, 35, 43, 0.1);
		}
		.search-results .search-item {
			display: block;
			padding: 12px 16px;
			text-decoration: none;
			color: var(--text-main);
			border-bottom: 1px dashed var(--card-border);
		}
		.search-results .search-item:last-child {
			border-bottom: none;
		}
		.search-results .search-item:hover {
			background: rgba(35, 35, 43, 0.05);
		}
		.search-results .search-item h4 {
			margin: 0;
			font-size: 14px;
		}
		.search-results .search-item p {
			margin: 2px 0 0;
			font-size: 12px;
			color: var(--text-sub);
		}
		.search-results .search-empty {
			padding: 14px 16px;
			font-size: 13px;
			color: var(--text-mute);
		}
		.search-results mark {
			background: var(--hi);
			color: #23232b;
			padding: 0 2px;
		}
	</style>

	<script define:vars={{ searchData, buildStamp, musicIds }}>
		/* ============ Toast ============ */
		var toastTimer;
		function showToast(msg) {
			var t = document.getElementById('toast');
			t.textContent = msg;
			t.classList.add('show');
			clearTimeout(toastTimer);
			toastTimer = setTimeout(function () {
				t.classList.remove('show');
			}, 2200);
		}

		/* ============ 搜索 ============ */
		var searchOpen = false;
		function escapeHtml(s) {
			return String(s).replace(/[&<>"']/g, function (c) {
				return {
					'&': '&amp;',
					'<': '&lt;',
					'>': '&gt;',
					'"': '&quot;',
					"'": '&#39;',
				}[c];
			});
		}
		function hl(text, q) {
			var t = escapeHtml(text);
			if (!q.trim()) return t;
			var re = new RegExp('(' + q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
			return t.replace(re, '<mark>$1</mark>');
		}
		function doSearch(q) {
			var box = document.getElementById('searchResults');
			if (!q.trim()) {
				box.classList.remove('show');
				return;
			}
			q = q.trim();
			if (window.__pfSearch) {
				window.__pfSearch(q, box);
				return;
			}
			window.__pfSearch = runSearch;
			var s = document.createElement('script');
			s.src = '/pagefind/pagefind.js';
			s.onload = function () {
				runSearch(q, box);
			};
			s.onerror = function () {
				box.innerHTML = '<div class="search-empty">搜索索引未生成，请先执行构建</div>';
				box.classList.add('show');
			};
			document.head.appendChild(s);
		}
		async function runSearch(q, box) {
			try {
				var res = await window.Pagefind.search(q);
				var items = (res.results || []).slice(0, 8);
				if (!items.length) {
					box.innerHTML = '<div class="search-empty">卷宗中未发现关于 <b>' + escapeHtml(q) + '</b> 的记录</div>';
					box.classList.add('show');
					return;
				}
				var data = await Promise.all(items.map(function (i) { return i.data(); }));
				var html = '';
				data.forEach(function (d) {
					var m = d.meta || {};
					var url = d.url || '#';
					var slug = url.replace(/\/+$/, '').split('/').pop();
					html +=
						'<a class="search-item" href="' +
						url +
						'"><h4>' +
						hl(m.title || slug, q) +
						'</h4><p>' +
						(d.excerpt || '') +
						'</p></a>';
				});
				box.innerHTML = html;
				box.classList.add('show');
			} catch (e) {
				box.innerHTML = '<div class="search-empty">搜索服务不可用</div>';
				box.classList.add('show');
			}
		}
		function toggleSearch(force) {
			var ov = document.getElementById('searchOverlay');
			searchOpen = typeof force === 'boolean' ? force : !searchOpen;
			ov.hidden = !searchOpen;
			if (searchOpen) {
				var inp = document.getElementById('searchInput');
				inp.focus();
				doSearch(inp.value);
			} else {
				document.getElementById('searchResults').classList.remove('show');
			}
		}
		document.getElementById('searchBtn').addEventListener('click', function (e) {
			e.stopPropagation();
			toggleSearch();
		});
		document.getElementById('searchOverlay').addEventListener('mousedown', function (e) {
			e.stopPropagation();
		});
		document.addEventListener('mousedown', function () {
			if (searchOpen) toggleSearch(false);
		});
		document.addEventListener('keydown', function (e) {
			if (e.key === 'Escape' && searchOpen) toggleSearch(false);
		});
		document.getElementById('searchInput').addEventListener('input', function (e) {
			doSearch(e.target.value);
		});
		document.getElementById('searchInput').addEventListener('focus', function (e) {
			doSearch(e.target.value);
		});

		/* ============ 播放器（真实播放，数据来自 CMS /api/music） ============ */
		var audio = new Audio();
		var cur = 0,
			playing = false,
			playlist = [];
		function fmt(s) {
			s = Math.max(0, Math.floor(s));
			return String(Math.floor(s / 60)).padStart(2, '0') + ':' + String(s % 60).padStart(2, '0');
		}
		function parseLrc(text) {
			var out = [];
			String(text || '').split('\n').forEach(function (line) {
				var times = [],
					m,
					re = /\[(\d{1,2}):(\d{1,2})(?:[.:](\d{1,3}))?\]/g;
				while ((m = re.exec(line))) times.push(+m[1] * 60 + +m[2] + (+(m[3] || 0)) / 1000);
				var rest = line.replace(re, '').trim();
				if (times.length && rest) times.forEach(function (t) { out.push({ time: t, text: rest }); });
			});
			out.sort(function (a, b) { return a.time - b.time; });
			return out;
		}
		function setPlayUi(on) {
			document.getElementById('disc').classList.toggle('paused', !on);
			document.getElementById('playIcon').innerHTML = on
				? '<path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>'
				: '<path d="M8 5v14l11-7z"/>';
			document.getElementById('nowEq').textContent = on ? '♫' : '♪';
		}
		function loadSong() {
			if (!playlist.length) return;
			var s = playlist[cur];
			document.getElementById('discImg').src = s.cover;
			document.getElementById('playerTitle').textContent = s.title;
			document.getElementById('playerArtist').textContent = s.artist;
			document.getElementById('nowTitle').textContent = s.title;
			document.getElementById('nowArtist').textContent = s.artist;
			document.getElementById('durTime').textContent = '00:00';
			document.getElementById('curTime').textContent = '00:00';
			document.getElementById('seekBar').value = 0;
			document.getElementById('seekBar').style.setProperty('--p', '0%');
			document.getElementById('playerLyric').textContent = '♪ 正在缓冲 ♪';
			audio.src = s.url;
			audio.load();
			if (playing) audio.play().catch(function () { setPlayUi(false); });
		}
		function togglePlay() {
			if (!audio.src) return;
			if (playing) {
				playing = false;
				audio.pause();
			} else {
				playing = true;
				audio.play().catch(function () { playing = false; });
			}
			setPlayUi(playing);
		}
		function nextSong() {
			if (!playlist.length) return;
			cur = (cur + 1) % playlist.length;
			loadSong();
			if (!playing) {
				playing = true;
				audio.play().catch(function () { playing = false; });
				setPlayUi(playing);
			}
		}
		function prevSong() {
			if (!playlist.length) return;
			cur = (cur - 1 + playlist.length) % playlist.length;
			loadSong();
			if (!playing) {
				playing = true;
				audio.play().catch(function () { playing = false; });
				setPlayUi(playing);
			}
		}
		function onSeek(v) {
			if (!audio.src) return;
			audio.currentTime = (v / 100) * (audio.duration || 0);
		}
		audio.addEventListener('loadedmetadata', function () {
			document.getElementById('durTime').textContent = fmt(audio.duration || 0);
		});
		audio.addEventListener('timeupdate', function () {
			var d = audio.duration || 1;
			var per = (audio.currentTime / d) * 100;
			document.getElementById('seekBar').value = per;
			document.getElementById('seekBar').style.setProperty('--p', per + '%');
			document.getElementById('curTime').textContent = fmt(audio.currentTime);
		});
		audio.addEventListener('ended', function () {
			cur = (cur + 1) % playlist.length;
			loadSong();
		});
		audio.addEventListener('error', function () {
			document.getElementById('playerLyric').textContent = '音频加载失败';
		});
		document.getElementById('playBtn').addEventListener('click', function (e) {
			e.stopPropagation();
			togglePlay();
		});
		document.getElementById('prevBtn').addEventListener('click', function (e) {
			e.stopPropagation();
			prevSong();
		});
		document.getElementById('nextBtn').addEventListener('click', function (e) {
			e.stopPropagation();
			nextSong();
		});
		document.getElementById('seekBar').addEventListener('input', function (e) {
			e.stopPropagation();
			onSeek(e.target.value);
		});
		document.getElementById('player').addEventListener('click', function () {
			var s = playlist[cur];
			if (s) {
				showToast('🎵 ' + s.title + ' - ' + s.artist);
			} else if (musicFailed) {
				showToast('🔄 音乐服务暂不可达，正在重试…');
				retryMusic();
			} else {
				showToast('🎵 音乐服务未配置');
			}
		});
		var musicFailed = false;
		function initMusic() {
			var ids = (window.musicIds || []).filter(Boolean);
			if (!ids.length) {
				document.getElementById('playerLyric').textContent = '音乐未配置（管理台歌单为空）';
				return;
			}
			document.getElementById('playerLyric').textContent = '正在连接云端...';
			fetch('/api/music?ids=' + ids.join(','))
				.then(function (r) { return r.json(); })
				.then(function (list) {
					playlist = (list || []).filter(function (s) { return s && s.url; }).map(function (s) {
						return {
							title: s.name,
							artist: s.artist,
							cover: s.cover,
							url: s.url,
							lyrics: parseLrc(s.lrc),
						};
					});
					if (!playlist.length) {
						musicFailed = true;
						document.getElementById('playerLyric').textContent = '云端链路受阻（点击卡片重试）';
						return;
					}
					musicFailed = false;
					document.getElementById('playerLyric').textContent = '♪ 第 1 / ' + playlist.length + ' 首';
					loadSong();
					playing = true;
					setPlayUi(true);
					audio.play().catch(function () {
						playing = false;
						setPlayUi(false);
					});
				})
				.catch(function () {
					musicFailed = true;
					document.getElementById('playerLyric').textContent = '音乐服务不可达（点击卡片重试）';
				});
		}
		function retryMusic() {
			musicFailed = false;
			playlist = [];
			cur = 0;
			initMusic();
		}
		initMusic();

		/* ============ 主题切换 ============ */
		function toggleTheme() {
			var html = document.documentElement;
			var isDark = html.getAttribute('data-theme') === 'dark';
			if (isDark) html.removeAttribute('data-theme');
			else html.setAttribute('data-theme', 'dark');
			document.getElementById('themeIcon').textContent = isDark ? '☀' : '☾';
			try {
				localStorage.setItem('theme', isDark ? 'light' : 'dark');
			} catch (e) {
				/* noop */
			}
		}
		document.getElementById('themeBtn').addEventListener('click', toggleTheme);
		(function initThemeIcon() {
			var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
			document.getElementById('themeIcon').textContent = isDark ? '☾' : '☀';
		})();
	</script>
</Layout>