---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { site } from '../lib/site';
import { musicIds } from '../data/music';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const formatter = new Intl.DateTimeFormat('zh-CN', {
	year: 'numeric',
	month: '2-digit',
	day: '2-digit',
});

const covers = [
	'https://bu.dusays.com/2026/03/24/69c1e38b346cb.jpg',
	'https://bu.dusays.com/2026/03/31/69cb69bb530d8.jpg',
	'https://bu.dusays.com/2026/03/24/69c26fe4acdb5.jpg',
	'https://bu.dusays.com/2026/03/24/69c1e38b4c370.jpg',
];

const searchData = posts.map((p, i) => ({
	slug: p.id,
	title: p.data.title,
	desc: p.data.description ?? '',
	date: formatter.format(p.data.pubDate),
	tags: p.data.tags ?? [],
	cover: covers[i % covers.length],
}));

const chatters = (await getCollection('moments'))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.map((m) => {
		const body = (m.body ?? '').trim().replace(/\r\n/g, '\n');
		const firstLine = body.split('\n').find((l) => l.trim()) ?? '一条新的说说';
		return {
			title: firstLine.slice(0, 24),
			desc: body.replace(/\s+/g, ' ').slice(0, 90),
			cover: m.data.images?.[0] ?? covers[0],
			date: formatter.format(m.data.date),
		};
	});

const buildStamp = '2026-08-14T00:00:00';
---

<Layout title="我的博客">
	<!-- 搜索框 -->
	<div class="search-wrap" id="searchWrap">
		<form onsubmit="return false;">
			<input
				class="search-input"
				id="searchInput"
				type="text"
				placeholder="搜寻标题、描述或标签..."
				autocomplete="off"
			/>
			<svg
				class="search-icon"
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2.5"
				stroke-linecap="round"
				stroke-linejoin="round"
				width="20"
				height="20"
			>
				<circle cx="11" cy="11" r="8"></circle>
				<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
			</svg>
		</form>
		<div class="search-results" id="searchResults"></div>
	</div>

	<!-- 页眉 -->
	<div class="glass paper-head">
		<h1 class="paper-title">我的博客</h1>
		<p class="paper-meta">
			在代码、学术与日常之间穿梭 · 最近更新于{' '}
			{posts[0] ? formatter.format(posts[0].data.pubDate) : '—'}
		</p>
	</div>

	<!-- 文章目录 -->
	<div class="glass paper-list mt-24">
		<div class="paper-list-head">
			<h2>最新文章</h2>
			<a class="paper-more" href="/blog">全部文章 →</a>
		</div>
		{posts.map((p, i) => (
			<a class="list-item" href={`/blog/${p.id}`}>
				<span class="no">{String(i + 1).padStart(2, '0')}</span>
				<span class="tt">{p.data.title}</span>
				<span class="dt">{formatter.format(p.data.pubDate)}</span>
			</a>
		))}
	</div>

	<!-- 歌词栏 -->
	<div class="lyricbar mt-24">
		<div class="waves" id="waves">
			<div class="wave w1"></div>
			<div class="wave w2"></div>
			<div class="wave w3"></div>
			<div class="wave w4"></div>
			<div class="wave w5"></div>
		</div>
		<div class="lyric-text"><p id="lyricLine"></p></div>
		<div class="music-note">
			<svg
				fill="none"
				viewBox="0 0 24 24"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
			><path d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/></svg>
		</div>
	</div>

	<!-- 两列：说说 + 组合面板 -->
	<div class="row row-2 mt-24">
		<div class="carousel chatter glass" id="chatterCarousel">
			<div class="carousel-bg" id="chatterBg"></div>
			<div class="carousel-content chatter-content">
				<div><span class="chatter-tag" id="chatterTag"></span></div>
				<h3 id="chatterTitle"></h3>
				<p id="chatterDesc"></p>
			</div>
			<div class="dots" id="chatterDots"></div>
		</div>

		<div class="col-stack">
			<a class="poster" href="/photowall">
				<img src="https://bu.dusays.com/2026/03/24/69c24230de927.jpg" alt="画廊" loading="lazy" />
				<div class="overlay"></div>
				<div class="info">
					<h3>照片画廊</h3>
					<p>光影与瞬间的视觉记录</p>
				</div>
			</a>
			<div class="glass player" id="player">
				<div class="player-glow" id="playerGlow"></div>
				<div class="player-head">
					<div class="disc" id="disc">
						<img id="discImg" src="" alt="cover" />
						<div class="hole"></div>
					</div>
					<div class="player-info">
						<span class="player-badge">Cloud Music</span>
						<h3 class="player-title" id="playerTitle"></h3>
						<p class="player-artist" id="playerArtist"></p>
					</div>
				</div>
				<div class="player-lyric" id="playerLyric"></div>
				<div>
					<div class="progress-row">
						<span class="t" id="curTime">00:00</span>
						<input type="range" class="seek" id="seekBar" min="0" max="100" value="0" />
						<span class="t2" id="durTime">00:00</span>
					</div>
					<div class="player-controls">
						<button class="ctrl-btn" id="prevBtn" title="上一首"><svg fill="currentColor" viewBox="0 0 24 24"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg></button>
						<button class="play-btn" id="playBtn" title="播放/暂停"><svg id="playIcon" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></button>
						<button class="ctrl-btn" id="nextBtn" title="下一首"><svg fill="currentColor" viewBox="0 0 24 24"><path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg></button>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- 底部：主题 + 仪表盘 -->
	<div class="row row-3 mt-24">
		<div class="theme-block glass" id="themeBlock">
			<div class="theme-orb">
				<div class="day"></div>
				<div class="night"></div>
				<div class="ico ico-sun">🌸</div>
				<div class="ico ico-moon">✨</div>
			</div>
			<h3 id="themeLabel">夜间模式</h3>
			<p id="themeDesc">流萤飞舞的深空</p>
		</div>

		<div class="dashboard glass">
			<div class="clock-box">
				<span id="clock">00:00:00</span>
				<div class="shine"></div>
				<div class="line"></div>
			</div>
			<div class="dash-info">
				<div class="dash-uptime">
					<span class="live-dot"></span>
					<span>系统已稳定运行：<b id="uptime"></b></span>
				</div>
				<div class="badges">
					<span class="badge"><svg fill="currentColor" viewBox="0 0 24 24" style="color:#ff5d01"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>Astro 7</span>
					<span class="badge"><svg fill="currentColor" viewBox="0 0 24 24" style="color:#3178c6"><path d="M23 0H1a1 1 0 00-1 1v22a1 1 0 001 1h22a1 1 0 001-1V1a1 1 0 00-1-1zM12 20.5l-1.5-.5c-2.5-.5-3.5-2-3.5-4.5h2.5c0 1.5.5 2.5 1.5 2.5.5 0 1-.5 1-2v-8.5l1.5-.5c1-.5 1.5-.5 1.5-.5s0 1 0 1.5v8c0 3-2.5 4.5-3 4.5zm9.5-4c-.5 1.5-2 2.5-4 2.5-2 0-3.5-1-3.5-2.5 0-1 1-2 2.5-2.5l1.5-.5v-1.5c-1 .5-2 .5-2.5.5 0-1.5-.5-2.5-.5-3 1.5 0 3 .5 3.5 1l1.5.5V2.5c0-1.5.5-2 1.5-2.5 1-.5 2-1 2.5-1v20l-1.5 1z"/></svg>TypeScript 5</span>
					<span class="badge"><svg fill="currentColor" viewBox="0 0 24 24" style="color:#0ea5e9"><path d="M14 3l1.7 3.2L19 6.8l-2.4 2.4.6 3.3-3.2-1.7-3.2 1.7.6-3.3L9 6.8l3.3-.6L14 3zM5 8l1.2 2.3L8.5 11.5l-2.3 1.2L5 15l-1.2-2.3L1.5 11.5l2.3-1.2L5 8zm14 8l-.9 1.8-1.8.9 1.8.9.9 1.8.9-1.8 1.8-.9-1.8-.9-.9-1.8z"/></svg>Markdown</span>
				</div>
				<a class="icp" href="/about">关于本站</a>
			</div>
		</div>
	</div>

	<style>
		.mt-24 {
			margin-top: 24px;
		}
		.col-stack {
			display: flex;
			flex-direction: column;
			gap: 24px;
		}

		/* ===== 纸墨 · 页眉 ===== */
		.paper-head {
			padding: 30px 32px;
		}
		.paper-title {
			font-size: 34px;
			font-weight: 900;
			letter-spacing: 0.06em;
		}
		.paper-meta {
			margin-top: 8px;
			font-size: 14px;
			color: var(--text-mute);
		}

		/* ===== 纸墨 · 文章目录 ===== */
		.paper-list {
			padding: 8px 28px 18px;
		}
		.paper-list-head {
			display: flex;
			align-items: baseline;
			justify-content: space-between;
			padding: 16px 0 6px;
			border-bottom: 1px solid rgba(28, 25, 23, 0.08);
		}
		.paper-list-head h2 {
			font-size: 18px;
			font-weight: 900;
			letter-spacing: 0.1em;
		}
		.paper-more {
			font-size: 13px;
			color: var(--indigo);
			text-decoration: none;
			font-weight: 700;
		}
		.paper-more:hover {
			text-decoration: underline;
		}
		.list-item {
			display: grid;
			grid-template-columns: 56px 1fr auto;
			gap: 16px;
			align-items: baseline;
			padding: 15px 6px;
			border-bottom: 1px solid rgba(28, 25, 23, 0.07);
			text-decoration: none;
			color: var(--text-main);
			border-radius: 8px;
			transition:
				background 0.25s,
				padding-left 0.25s;
		}
		.list-item:last-child {
			border-bottom: none;
		}
		.list-item:hover {
			background: rgba(255, 255, 255, 0.45);
			padding-left: 12px;
		}
		.list-item .no {
			font-family: Consolas, Menlo, monospace;
			font-size: 13px;
			color: var(--indigo);
		}
		.list-item .tt {
			font-weight: 900;
			font-size: 17px;
			letter-spacing: 0.02em;
		}
		.list-item .dt {
			color: var(--text-mute);
			font-size: 13px;
			font-family: Consolas, Menlo, monospace;
		}

		/* 底部行布局 */
		.row-3 {
			display: grid;
			grid-template-columns: 320px 1fr;
			gap: 24px;
		}
		@media (max-width: 760px) {
			.row-3 {
				grid-template-columns: 1fr;
			}
			.list-item {
				grid-template-columns: 40px 1fr;
			}
			.list-item .dt {
				display: none;
			}
		}
	</style>

	<script define:vars={{ searchData, chatters, buildStamp, musicIds }}>
		/* ============ Toast / 复制 ============ */
		var toastTimer;
		function showToast(msg) {
			var t = document.getElementById('toast');
			t.textContent = msg;
			t.classList.add('show');
			clearTimeout(toastTimer);
			toastTimer = setTimeout(function () {
				t.classList.remove('show');
			}, 2200);
		}
		function copy(text, label) {
			if (navigator.clipboard) navigator.clipboard.writeText(text);
			showToast('✨ ' + label + '已复制到剪贴板: ' + text);
		}

		/* ============ 个人名片 / 社交 ============ */
		/* ============ 社交 ============ */
		document.querySelectorAll('.social-btn').forEach(function (btn) {
			btn.addEventListener('click', function (e) {
				e.stopPropagation();
				copy(btn.getAttribute('data-copy'), btn.getAttribute('data-label'));
			});
		});

		/* ============ 搜索 ============ */
		function escapeHtml(s) {
			return String(s).replace(/[&<>"']/g, function (c) {
				return {
					'&': '&amp;',
					'<': '&lt;',
					'>': '&gt;',
					'"': '&quot;',
					"'": '&#39;',
				}[c];
			});
		}
		function hl(text, q) {
			var t = escapeHtml(text);
			if (!q.trim()) return t;
			var re = new RegExp('(' + q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
			return t.replace(re, '<mark>$1</mark>');
		}
		function doSearch(q) {
			var box = document.getElementById('searchResults');
			if (!q.trim()) {
				box.classList.remove('show');
				return;
			}
			q = q.trim();
			if (window.__pfSearch) {
				window.__pfSearch(q, box);
				return;
			}
			window.__pfSearch = runSearch;
			var s = document.createElement('script');
			s.src = '/pagefind/pagefind.js';
			s.onload = function () {
				runSearch(q, box);
			};
			s.onerror = function () {
				box.innerHTML = '<div class="search-empty">搜索索引未生成，请先执行构建</div>';
				box.classList.add('show');
			};
			document.head.appendChild(s);
		}
		async function runSearch(q, box) {
			try {
				var res = await window.Pagefind.search(q);
				var items = (res.results || []).slice(0, 8);
				if (!items.length) {
					box.innerHTML = '<div class="search-empty">数据海中未发现关于 <b>' + escapeHtml(q) + '</b> 的踪迹</div>';
					box.classList.add('show');
					return;
				}
				var data = await Promise.all(items.map(function (i) { return i.data(); }));
				var html = '';
				data.forEach(function (d) {
					var m = d.meta || {};
					var url = d.url || '#';
					var slug = url.replace(/\/+$/, '').split('/').pop();
					html +=
						'<a class="search-item" href="' +
						url +
						'"><h4>' +
						hl(m.title || slug, q) +
						'</h4><p>' +
						(d.excerpt || '') +
						'</p></a>';
				});
				box.innerHTML = html;
				box.classList.add('show');
			} catch (e) {
				box.innerHTML = '<div class="search-empty">搜索服务不可用</div>';
				box.classList.add('show');
			}
		}
		document.getElementById('searchInput').addEventListener('input', function (e) {
			doSearch(e.target.value);
		});
		document.getElementById('searchInput').addEventListener('focus', function (e) {
			doSearch(e.target.value);
		});
		document.addEventListener('mousedown', function (e) {
			var w = document.getElementById('searchWrap');
			if (!w.contains(e.target)) {
				document.getElementById('searchResults').classList.remove('show');
			}
		});

		/* ============ 播放器（真实播放，数据来自 CMS /api/music） ============ */
		var audio = new Audio();
		var cur = 0,
			playing = false,
			playlist = [];
		function fmt(s) {
			s = Math.max(0, Math.floor(s));
			return String(Math.floor(s / 60)).padStart(2, '0') + ':' + String(s % 60).padStart(2, '0');
		}
		function parseLrc(text) {
			var out = [];
			String(text || '').split('\n').forEach(function (line) {
				var times = [],
					m,
					re = /\[(\d{1,2}):(\d{1,2})(?:[.:](\d{1,3}))?\]/g;
				while ((m = re.exec(line))) times.push(+m[1] * 60 + +m[2] + (+(m[3] || 0)) / 1000);
				var rest = line.replace(re, '').trim();
				if (times.length && rest) times.forEach(function (t) { out.push({ time: t, text: rest }); });
			});
			out.sort(function (a, b) { return a.time - b.time; });
			return out;
		}
		function setPlayUi(on) {
			document.getElementById('disc').classList.toggle('paused', !on);
			document.getElementById('playIcon').innerHTML = on
				? '<path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>'
				: '<path d="M8 5v14l11-7z"/>';
			document.querySelectorAll('.wave').forEach(function (w) {
				w.classList.toggle('on', on);
			});
			document.getElementById('playerGlow').style.opacity = on ? '1' : '0.3';
		}
		function loadSong() {
			if (!playlist.length) return;
			var s = playlist[cur];
			document.getElementById('discImg').src = s.cover;
			document.getElementById('playerTitle').textContent = s.title;
			document.getElementById('playerArtist').textContent = s.artist;
			document.getElementById('durTime').textContent = '00:00';
			document.getElementById('curTime').textContent = '00:00';
			document.getElementById('seekBar').value = 0;
			document.getElementById('seekBar').style.setProperty('--p', '0%');
			document.getElementById('playerLyric').textContent = '♪ 正在缓冲 ♪';
			var lyricLine = document.getElementById('lyricLine');
			lyricLine.textContent = s.lyrics && s.lyrics.length ? s.lyrics[0].text : '♪ 纯享音乐 ♪';
			lyricLine.style.opacity = 1;
			audio.src = s.url;
			audio.load();
			if (playing) audio.play().catch(function () { setPlayUi(false); });
		}
		function togglePlay() {
			if (!audio.src) return;
			if (playing) {
				playing = false;
				audio.pause();
			} else {
				playing = true;
				audio.play().catch(function () { playing = false; });
			}
			setPlayUi(playing);
		}
		function nextSong() {
			if (!playlist.length) return;
			cur = (cur + 1) % playlist.length;
			loadSong();
			if (!playing) {
				playing = true;
				audio.play().catch(function () { playing = false; });
				setPlayUi(playing);
			}
		}
		function prevSong() {
			if (!playlist.length) return;
			cur = (cur - 1 + playlist.length) % playlist.length;
			loadSong();
			if (!playing) {
				playing = true;
				audio.play().catch(function () { playing = false; });
				setPlayUi(playing);
			}
		}
		function onSeek(v) {
			if (!audio.src) return;
			audio.currentTime = (v / 100) * (audio.duration || 0);
		}
		audio.addEventListener('loadedmetadata', function () {
			document.getElementById('durTime').textContent = fmt(audio.duration || 0);
		});
		audio.addEventListener('timeupdate', function () {
			var d = audio.duration || 1;
			var per = (audio.currentTime / d) * 100;
			document.getElementById('seekBar').value = per;
			document.getElementById('seekBar').style.setProperty('--p', per + '%');
			document.getElementById('curTime').textContent = fmt(audio.currentTime);
			var s = playlist[cur];
			if (!s || !s.lyrics || !s.lyrics.length) return;
			var li = 0;
			for (var i = 0; i < s.lyrics.length; i++) {
				if (s.lyrics[i].time <= audio.currentTime + 0.2) li = i;
				else break;
			}
			var line = document.getElementById('lyricLine');
			if (line.textContent !== s.lyrics[li].text) {
				line.textContent = s.lyrics[li].text;
				line.style.opacity = 1;
			} else if (li < s.lyrics.length - 1) {
				var per2 = (audio.currentTime - s.lyrics[li].time) / (s.lyrics[li + 1].time - s.lyrics[li].time);
				line.style.opacity = 0.55 + 0.45 * Math.min(1, Math.max(0, per2));
			}
		});
		audio.addEventListener('ended', function () {
			cur = (cur + 1) % playlist.length;
			loadSong();
		});
		audio.addEventListener('error', function () {
			document.getElementById('playerLyric').textContent = '音频加载失败';
		});
		document.getElementById('playBtn').addEventListener('click', function (e) {
			e.stopPropagation();
			togglePlay();
		});
		document.getElementById('prevBtn').addEventListener('click', function (e) {
			e.stopPropagation();
			prevSong();
		});
		document.getElementById('nextBtn').addEventListener('click', function (e) {
			e.stopPropagation();
			nextSong();
		});
		document.getElementById('seekBar').addEventListener('input', function (e) {
			e.stopPropagation();
			onSeek(e.target.value);
		});
		document.getElementById('player').addEventListener('click', function () {
			var s = playlist[cur];
			if (s) {
				showToast('🎵 ' + s.title + ' - ' + s.artist);
			} else if (musicFailed) {
				showToast('🔄 音乐服务暂不可达，正在重试…');
				retryMusic();
			} else {
				showToast('🎵 音乐服务未配置');
			}
		});
		var musicFailed = false;
		function initMusic() {
			var ids = (window.musicIds || []).filter(Boolean);
			if (!ids.length) {
				document.getElementById('playerLyric').textContent = '音乐未配置（管理台歌单为空）';
				return;
			}
			document.getElementById('playerLyric').textContent = '正在连接云端...';
			fetch('/api/music?ids=' + ids.join(','))
				.then(function (r) { return r.json(); })
				.then(function (list) {
					playlist = (list || []).filter(function (s) { return s && s.url; }).map(function (s) {
						return {
							title: s.name,
							artist: s.artist,
							cover: s.cover,
							url: s.url,
							lyrics: parseLrc(s.lrc),
						};
					});
					if (!playlist.length) {
						musicFailed = true;
						document.getElementById('playerLyric').textContent = '云端链路受阻（点击卡片重试）';
						return;
					}
					musicFailed = false;
					loadSong();
					playing = true;
					setPlayUi(true);
					audio.play().catch(function () {
						playing = false;
						setPlayUi(false);
					});
				})
				.catch(function () {
					musicFailed = true;
					document.getElementById('playerLyric').textContent = '音乐服务不可达（点击卡片重试）';
				});
		}
		function retryMusic() {
			musicFailed = false;
			playlist = [];
			cur = 0;
			initMusic();
		}
		initMusic();

		/* ============ 说说轮播 ============ */
		var ci = 0,
			ctimer;
		function renderChatter() {
			if (!chatters.length) {
				document.getElementById('chatterTitle').textContent = '暂无说说';
				document.getElementById('chatterDesc').textContent = '去发布你的第一条记录吧';
				return;
			}
			var c = chatters[ci];
			document.getElementById('chatterBg').innerHTML =
				'<img src="' + c.cover + '" alt=""><div class="shade"></div>';
			document.getElementById('chatterTitle').textContent = c.title;
			document.getElementById('chatterDesc').textContent = c.desc;
			document.getElementById('chatterTag').textContent = 'Records · ' + c.date;
			var dots = document.getElementById('chatterDots');
			dots.innerHTML = '';
			chatters.forEach(function (_, i) {
				var b = document.createElement('button');
				b.className = 'dot ' + (i === ci ? 'active' : 'inactive');
				b.addEventListener('click', function (e) {
					e.stopPropagation();
					ci = i;
					renderChatter();
					restartChatter();
				});
				dots.appendChild(b);
			});
		}
		function restartChatter() {
			clearInterval(ctimer);
			if (chatters.length > 1)
				ctimer = setInterval(function () {
					ci = (ci + 1) % chatters.length;
					renderChatter();
				}, 6000);
		}
		renderChatter();
		restartChatter();
		document.getElementById('chatterCarousel').addEventListener('click', function () {
			window.location.href = '/moments';
		});

		/* ============ 主题切换 ============ */
		function toggleTheme() {
			var html = document.documentElement;
			var isDark = html.getAttribute('data-theme') === 'dark';
			html.setAttribute('data-theme', isDark ? 'light' : 'dark');
			document.getElementById('themeLabel').textContent = isDark ? '日间模式' : '夜间模式';
			document.getElementById('themeDesc').textContent = isDark ? '落樱漫舞的清晨' : '流萤飞舞的深空';
			try {
				localStorage.setItem('theme', isDark ? 'light' : 'dark');
			} catch (e) {
				/* noop */
			}
		}
		document.getElementById('themeBlock').addEventListener('click', toggleTheme);
		(function initThemeLabel() {
			var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
			document.getElementById('themeLabel').textContent = isDark ? '夜间模式' : '日间模式';
			document.getElementById('themeDesc').textContent = isDark ? '流萤飞舞的深空' : '落樱漫舞的清晨';
		})();

		/* ============ 站点仪表盘 ============ */
		var BUILD = new Date(buildStamp).getTime();
		setInterval(function () {
			var now = new Date();
			document.getElementById('clock').textContent = now.toLocaleTimeString('en-US', {
				hour12: false,
				hour: '2-digit',
				minute: '2-digit',
				second: '2-digit',
			});
			var diff = now.getTime() - BUILD;
			var days = Math.floor(diff / 86400000),
				hours = Math.floor((diff % 86400000) / 3600000);
			document.getElementById('uptime').textContent = days + '天 ' + hours + '小时';
		}, 1000);
	</script>
</Layout>