---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	const tagSet = new Set<string>();
	posts.forEach((post) => (post.data.tags ?? []).forEach((tag) => tagSet.add(tag)));
	return [...tagSet].map((tag) => ({ params: { tag }, props: { tag } }));
}

const { tag } = Astro.props;

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.filter((post) => post.data.tags?.includes(tag))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatter = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
---

<Layout title={`#${tag} · 标签`} description={`标签 #${tag} 下的全部文章。`}>
	<section class="page-head">
		<a href="/tags" class="back-link">← 全部标签</a>
		<h1><span class="hash">#</span>{tag}</h1>
		<p class="page-sub">共 {posts.length} 篇文章</p>
	</section>

	<div class="post-list">
		{
			posts.map((post) => (
				<a href={`/blog/${post.id}`} class="post-card glass">
					{post.data.cover && <img class="post-thumb" src={post.data.cover} alt={post.data.title} loading="lazy" />}
					<div class="post-body">
						<h2>{post.data.title}</h2>
						<div class="post-meta">
							<time datetime={post.data.pubDate.toISOString()}>
								{formatter.format(post.data.pubDate)}
							</time>
							{post.data.tags?.slice(0, 3).map((t) => <span class="tag">{t}</span>)}
						</div>
						{post.data.description && <p>{post.data.description}</p>}
					</div>
				</a>
			))
		}
	</div>
</Layout>

<style>
	.page-head {
		margin: 8px 0 28px;
	}
	.back-link {
		display: inline-block;
		font-size: 13px;
		font-weight: 700;
		color: var(--text-mute);
		text-decoration: none;
		margin-bottom: 12px;
		transition: color 0.25s;
	}
	.back-link:hover {
		color: var(--indigo);
	}
	.page-head h1 {
		font-size: 30px;
		font-weight: 900;
		letter-spacing: 0.08em;
	}
	.hash {
		color: var(--indigo);
	}
	.page-sub {
		color: var(--text-mute);
		font-size: 13px;
		margin-top: 6px;
	}
	.post-list {
		max-width: 780px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 18px;
	}
	.post-card {
		display: grid;
		grid-template-columns: 1fr;
		gap: 14px;
		padding: 20px 22px;
		text-decoration: none;
		border-left: 3px solid transparent;
		transition:
			transform 0.25s,
			border-color 0.25s,
			background 0.25s,
			box-shadow 0.25s;
	}
	.post-card:hover {
		transform: translateX(4px);
		border-left-color: var(--seal);
		background: rgba(35, 35, 43, 0.035);
		box-shadow: 3px 3px 0 rgba(35, 35, 43, 0.07);
	}
	[data-theme='dark'] .post-card:hover {
		background: rgba(230, 228, 221, 0.04);
		box-shadow: 3px 3px 0 rgba(230, 228, 221, 0.08);
	}
	.post-thumb {
		width: 100%;
		height: 150px;
		object-fit: cover;
		border-radius: 4px;
	}
	.post-body h2 {
		font-family: var(--serif);
		font-size: 19px;
		font-weight: 900;
		letter-spacing: 0.02em;
		transition: color 0.25s;
	}
	.post-card:hover .post-body h2 {
		color: var(--indigo);
	}
	.post-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		margin: 8px 0;
		font-size: 12px;
		color: var(--text-mute);
	}
	.post-body p {
		font-size: 14px;
		color: var(--text-sub);
		line-height: 1.8;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	@media (min-width: 640px) {
		.post-card {
			grid-template-columns: 150px 1fr;
			align-items: start;
		}
		.post-thumb {
			height: 104px;
		}
	}
</style>