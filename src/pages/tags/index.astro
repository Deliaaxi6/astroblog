---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = await getCollection('blog', ({ data }) => !data.draft);

const tagCounts = new Map<string, number>();
posts.forEach((post) =>
	(post.data.tags ?? []).forEach((tag) => tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1))
);
const tags = [...tagCounts.entries()]
	.map(([name, count]) => ({ name, count }))
	.sort((a, b) => b.count - a.count);
const maxCount = Math.max(1, ...tags.map((t) => t.count));
---

<Layout title="标签" description="全部文章标签聚合。">
	<section class="page-head">
		<h1>标签聚合</h1>
		<p class="page-sub">✳️ 共 {tags.length} 个标签 · 覆盖 {posts.length} 篇文章</p>
	</section>

	<div class="tag-cloud">
		{
			tags.map((tag) => (
				<a
					href={`/tags/${tag.name}`}
					class="tag-item"
					style={`--size: ${0.95 + (tag.count / maxCount) * 0.9}; --op: ${0.55 + (tag.count / maxCount) * 0.45}`}
				>
					#{tag.name}
					<span class="tag-count">{tag.count}</span>
				</a>
			))
		}
	</div>

	{
		tags.length === 0 && (
			<div class="tag-empty">
				<h2>还没有任何标签</h2>
				<p>在文章 frontmatter 中添加 tags 字段后会自动出现在这里。</p>
			</div>
		)
	}
</Layout>

<style>
	.page-head {
		text-align: center;
		margin: 16px 0 40px;
	}
	.page-head h1 {
		font-size: 34px;
		font-weight: 900;
		letter-spacing: 0.1em;
		background: linear-gradient(120deg, var(--text-main), var(--indigo-light));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
	.page-sub {
		color: var(--text-mute);
		font-size: 14px;
		margin-top: 8px;
	}
	.tag-cloud {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 14px;
		max-width: 720px;
		margin: 0 auto;
		padding: 40px 24px;
	}
	.tag-item {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-size: calc(15px * var(--size));
		font-weight: 800;
		opacity: var(--op);
		color: var(--indigo-light);
		text-decoration: none;
		padding: 8px 16px;
		border-radius: 999px;
		border: 1px solid rgba(99, 102, 241, 0.25);
		background: rgba(99, 102, 241, 0.07);
		transition: all 0.3s;
	}
	.tag-item:hover {
		opacity: 1;
		color: #fff;
		background: linear-gradient(120deg, var(--indigo), var(--purple));
		border-color: transparent;
		transform: translateY(-2px) scale(1.05);
		box-shadow: 0 10px 24px -8px rgba(99, 102, 241, 0.5);
	}
	.tag-count {
		font-size: 0.68em;
		font-weight: 700;
		background: rgba(99, 102, 241, 0.2);
		padding: 2px 8px;
		border-radius: 999px;
	}
	.tag-item:hover .tag-count {
		background: rgba(255, 255, 255, 0.2);
	}
	.tag-empty {
		text-align: center;
		padding: 70px 0;
		color: var(--text-mute);
	}
	.tag-empty h2 {
		font-size: 22px;
		color: var(--text-sub);
		margin-bottom: 8px;
	}
</style>