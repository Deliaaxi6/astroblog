---
/**
 * CreateAlbumModal · 新建相册弹窗（最小 client Island）
 *
 * 「创建新相册」虚线卡片 + 原生 <dialog> 弹窗：
 * 名称 / 封面（必须）/ 描述（可选）→ POST 本地 CMS /api/gallery/albums
 * → 触发博客重建 → 跳转相册详情页。
 */
---

<button type="button" class="create-card" id="gallery-create-btn">
	<span class="create-icon">＋</span>
	<span>创建新相册</span>
</button>

<dialog class="album-dialog" id="gallery-create-dialog">
	<form id="gallery-create-form">
		<h3 class="dialog-title">新建相册</h3>
		<label class="dialog-field">
			<span>相册名称</span>
			<input id="gal-title" type="text" required placeholder="例如：罗德岛之旅" />
		</label>
		<label class="dialog-field">
			<span>封面图片</span>
			<input id="gal-cover" type="file" accept="image/*" required />
		</label>
		<label class="dialog-field">
			<span>描述（可选）</span>
			<textarea id="gal-desc" rows="3" placeholder="记录这段光影…"></textarea>
		</label>
		<p class="dialog-msg" id="gal-msg"></p>
		<div class="dialog-actions">
			<button type="button" class="dialog-btn ghost" id="gal-cancel">取消</button>
			<button type="submit" class="dialog-btn primary" id="gal-submit">创建</button>
		</div>
	</form>
</dialog>

<style>
	.create-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 12px;
		min-height: 248px;
		border: 1.5px dashed rgba(167, 139, 250, 0.45);
		border-radius: 14px;
		background: transparent;
		color: rgba(216, 210, 255, 0.72);
		font-size: 14px;
		cursor: pointer;
		transition: border-color 0.25s, box-shadow 0.25s, color 0.25s;
	}
	.create-card:hover {
		border-color: rgba(167, 139, 250, 0.95);
		box-shadow: 0 0 26px rgba(139, 92, 246, 0.35), inset 0 0 18px rgba(139, 92, 246, 0.08);
		color: #fff;
	}
	.create-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 46px;
		height: 46px;
		border-radius: 50%;
		border: 1.5px dashed rgba(167, 139, 250, 0.6);
		font-size: 22px;
		line-height: 1;
	}
	.create-card:hover .create-icon {
		border-color: rgba(167, 139, 250, 0.95);
	}

	.album-dialog {
		border: 1px solid rgba(167, 139, 250, 0.35);
		border-radius: 16px;
		background: linear-gradient(160deg, #1b1233 0%, #120b26 100%);
		color: #e8e4ff;
		padding: 28px;
		width: min(420px, calc(100vw - 40px));
		box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
	}
	.album-dialog::backdrop {
		background: rgba(4, 2, 12, 0.7);
		backdrop-filter: blur(3px);
	}
	.dialog-title {
		margin: 0 0 18px;
		font-size: 18px;
		letter-spacing: 1px;
	}
	.dialog-field {
		display: block;
		margin-bottom: 14px;
	}
	.dialog-field span {
		display: block;
		margin-bottom: 6px;
		font-size: 12px;
		color: rgba(216, 210, 255, 0.7);
	}
	.dialog-field input,
	.dialog-field textarea {
		width: 100%;
		box-sizing: border-box;
		padding: 10px 12px;
		border-radius: 8px;
		border: 1px solid rgba(167, 139, 250, 0.3);
		background: rgba(15, 9, 32, 0.7);
		color: #e8e4ff;
		font-size: 13px;
		outline: none;
		resize: vertical;
	}
	.dialog-field input:focus,
	.dialog-field textarea:focus {
		border-color: rgba(167, 139, 250, 0.9);
	}
	.dialog-field input[type='file'] {
		padding: 8px;
	}
	.dialog-msg {
		min-height: 16px;
		margin: 0 0 8px;
		font-size: 12px;
		color: #f0a8a0;
	}
	.dialog-actions {
		display: flex;
		justify-content: flex-end;
		gap: 10px;
	}
	.dialog-btn {
		padding: 9px 22px;
		border-radius: 8px;
		border: none;
		font-size: 13px;
		cursor: pointer;
		transition: opacity 0.2s;
	}
	.dialog-btn:disabled {
		opacity: 0.55;
		cursor: not-allowed;
	}
	.dialog-btn.ghost {
		background: rgba(255, 255, 255, 0.08);
		color: #cfc8f5;
	}
	.dialog-btn.primary {
		background: linear-gradient(135deg, #8b5cf6, #6d28d9);
		color: #fff;
		font-weight: 600;
	}
</style>

<script>
	const CMS_BASE = 'http://localhost:8080';
	const btn = document.getElementById('gallery-create-btn');
	const dialog = document.getElementById('gallery-create-dialog');
	const form = document.getElementById('gallery-create-form');
	const msg = document.getElementById('gal-msg');

	const waitBuild = () =>
		new Promise((resolve) => {
			const check = async () => {
				try {
					const r = await fetch(CMS_BASE + '/api/sync/status', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: '{}',
					});
					const j = await r.json();
					if (j.status && !j.status.running) return resolve(j.status.last_exit);
				} catch (e) {
					/* 轮询继续 */
				}
				setTimeout(check, 1500);
			};
			check();
		});

	btn.addEventListener('click', () => dialog.showModal());
	document.getElementById('gal-cancel').addEventListener('click', () => dialog.close());

	form.addEventListener('submit', async (e) => {
		e.preventDefault();
		const submit = document.getElementById('gal-submit');
		const title = document.getElementById('gal-title');
		const cover = document.getElementById('gal-cover');
		submit.disabled = true;
		msg.textContent = '创建中…';
		try {
			if (!cover.files || !cover.files[0]) throw new Error('请选择封面图片');
			const fd = new FormData();
			fd.append('title', title.value.trim());
			fd.append('description', document.getElementById('gal-desc').value.trim());
			fd.append('cover', cover.files[0]);
			const r = await fetch(CMS_BASE + '/api/gallery/albums', { method: 'POST', body: fd });
			const j = await r.json();
			if (!j.success) throw new Error(j.message || '创建失败');
			msg.textContent = '已创建，正在重建站点…';
			await fetch(CMS_BASE + '/api/sync/rebuild', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: '{}',
			});
			const exit = await waitBuild();
			if (exit !== 0) throw new Error('站点重建失败，请稍后手动刷新');
			dialog.close();
			msg.textContent = '';
			location.href = '/admin/gallery/' + j.id;
		} catch (err) {
			msg.textContent = err.message;
		} finally {
			submit.disabled = false;
		}
	});
</script>