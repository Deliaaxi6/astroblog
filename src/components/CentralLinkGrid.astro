---
/**
 * 中枢链路 · 深空网格组件
 *
 * 纯 Astro + TypeScript + TailwindCSS 实现，与 CentralLinkTimeline 配套，
 * 仅在 viewMode = 'grid' 时渲染。SSR 静态渲染 + Web Component 响应筛选更新。
 */

import type { Article } from './CentralLinkTimeline.astro';
import { withBase } from '../lib/site';

interface Props {
	/** 外部传入的文章列表（可按关键词/标签筛选后传入，组件自动刷新） */
	articleList: Article[];
	/** 视图模式：本组件仅渲染 grid 模式 */
	viewMode?: 'timeline' | 'grid';
}

const { articleList, viewMode = 'grid' } = Astro.props;

const sorted = [...articleList].sort(
	(a, b) => new Date(b.publishAt).valueOf() - new Date(a.publishAt).valueOf()
);

const formatter = new Intl.DateTimeFormat('zh-CN', {
	year: 'numeric',
	month: '2-digit',
	day: '2-digit',
});
const fmt = (iso: string): string => {
	const d = new Date(iso);
	return Number.isNaN(d.valueOf()) ? iso : formatter.format(d);
};
---

{
	viewMode === 'grid' ? (
		<central-link-grid class="cg-root" data-base={withBase('/')} articles={JSON.stringify(sorted)}>
			<div class="cg-grid">
				{
					sorted.map((a) => (
						<a href={withBase(`/blog/${a.id}`)} class="cg-card">
							<div class:list={['cg-cover', !a.cover && 'cg-cover-fallback']}>
								{a.cover && <img src={withBase(a.cover)} alt={a.title} loading="lazy" />}
								<span class="cg-date">{fmt(a.publishAt)}</span>
							</div>
							<div class="cg-body">
								<h3 class="cg-title">{a.title}</h3>
								<p class="cg-summary">{a.summary ?? '暂无描述'}</p>
								{a.tags?.length ? (
									<div class="cg-tags">
										{a.tags.map((t) => (
											<span class="cg-tag">{t}</span>
										))}
									</div>
								) : null}
							</div>
						</a>
					))
				}
			</div>
			<p class="cg-empty" hidden>没有匹配的档案</p>
		</central-link-grid>
	) : (
		<central-link-grid class="cg-root" data-base={withBase('/')} data-view="timeline" hidden></central-link-grid>
	)
}

<style is:global>
	.cg-root {
		position: relative;
		display: block;
		overflow: hidden;
		border-radius: 20px;
		padding: 28px;
		background:
			radial-gradient(800px 440px at 85% -10%, rgba(176, 46, 38, 0.06), transparent 60%),
			radial-gradient(700px 400px at 5% 110%, rgba(49, 87, 122, 0.08), transparent 60%),
			linear-gradient(180deg, #fbfaf6 0%, #f4f3ef 60%, #ecebe4 100%);
		border: 1px solid var(--card-border);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.6),
			0 24px 48px -16px rgba(35, 35, 43, 0.25);
	}
	[data-theme='dark'] .cg-root {
		background:
			radial-gradient(800px 440px at 85% -10%, rgba(176, 46, 38, 0.09), transparent 60%),
			radial-gradient(700px 400px at 5% 110%, rgba(49, 87, 122, 0.11), transparent 60%),
			linear-gradient(180deg, #23242c 0%, #1c1d24 60%, #17181e 100%);
		border-color: rgba(230, 228, 221, 0.14);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.05),
			0 24px 48px -16px rgba(0, 0, 0, 0.6);
	}
	.cg-grid {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 18px;
	}
	.cg-card {
		display: flex;
		flex-direction: column;
		border-radius: 16px;
		overflow: hidden;
		text-decoration: none;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		transition:
			transform 0.35s ease,
			box-shadow 0.35s ease,
			border-color 0.35s ease,
			background 0.35s ease;
	}
	.cg-card:hover {
		transform: translateY(-4px);
		border-color: rgba(176, 46, 38, 0.4);
		background: rgba(255, 255, 255, 0.65);
		box-shadow: 0 18px 40px -14px rgba(176, 46, 38, 0.22);
	}
	[data-theme='dark'] .cg-card:hover {
		border-color: rgba(208, 90, 80, 0.45);
		background: rgba(51, 65, 85, 0.35);
		box-shadow: 0 18px 40px -14px rgba(208, 90, 80, 0.35);
	}
	.cg-cover {
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: linear-gradient(135deg, rgba(176, 46, 38, 0.14), rgba(49, 87, 122, 0.18));
	}
	.cg-cover img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.6s ease;
	}
	.cg-card:hover .cg-cover img {
		transform: scale(1.08);
	}
	.cg-cover::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(35, 35, 43, 0.4), transparent);
	}
	[data-theme='dark'] .cg-cover::after {
		background: linear-gradient(to top, rgba(2, 6, 23, 0.55), transparent);
	}
	.cg-cover-fallback {
		background: linear-gradient(135deg, rgba(176, 46, 38, 0.14), rgba(49, 87, 122, 0.18));
	}
	.cg-date {
		position: absolute;
		left: 12px;
		bottom: 10px;
		z-index: 1;
		font-size: 10px;
		font-weight: 700;
		font-family: ui-monospace, Consolas, Menlo, monospace;
		letter-spacing: 0.06em;
		color: rgba(255, 255, 255, 0.95);
		background: rgba(35, 35, 43, 0.45);
		backdrop-filter: blur(4px);
		-webkit-backdrop-filter: blur(4px);
		padding: 4px 10px;
		border-radius: 6px;
		border: 1px solid rgba(176, 46, 38, 0.25);
	}
	.cg-body {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 16px 18px 18px;
	}
	.cg-title {
		font-size: 15px;
		font-weight: 700;
		line-height: 1.4;
		color: var(--text-main);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		transition: color 0.3s ease;
	}
	.cg-card:hover .cg-title {
		color: var(--indigo);
	}
	.cg-summary {
		font-size: 12px;
		line-height: 1.6;
		color: var(--text-sub);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.cg-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}
	.cg-tag {
		font-size: 10px;
		font-weight: 600;
		color: var(--indigo-light);
		background: rgba(176, 46, 38, 0.1);
		border: 1px solid rgba(176, 46, 38, 0.18);
		padding: 3px 9px;
		border-radius: 6px;
	}
	.cg-empty {
		position: relative;
		z-index: 1;
		text-align: center;
		padding: 80px 24px;
		color: var(--text-mute);
		font-size: 14px;
		letter-spacing: 0.06em;
	}
</style>

<script>
	interface GridArticle {
		id: string;
		title: string;
		cover?: string;
		summary?: string;
		tags?: string[];
		publishAt: string;
	}

	const escapeHtml = (s: string): string =>
		String(s ?? '').replace(/[&<>"']/g, (c) => {
			const map: Record<string, string> = {
				'&': '&amp;',
				'<': '&lt;',
				'>': '&gt;',
				'"': '&quot;',
				"'": '&#39;',
			};
			return map[c] ?? c;
		});

	const dateFmt = new Intl.DateTimeFormat('zh-CN', {
		year: 'numeric',
		month: '2-digit',
		day: '2-digit',
	});

	const fmtDate = (iso: string): string => {
		const d = new Date(iso);
		return Number.isNaN(d.valueOf()) ? iso : dateFmt.format(d);
	};

	const withClientBase = (base: string, path: string): string => {
		if (/^[a-z][a-z\d+.-]*:/i.test(path) || path.startsWith('//') || path.startsWith('#')) return path;
		return `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
	};

	const cardHtml = (a: GridArticle, base: string): string => `
		<a href="${escapeHtml(withClientBase(base, '/blog/' + a.id))}" class="cg-card">
			<div class="cg-cover ${a.cover ? '' : 'cg-cover-fallback'}">
				${a.cover ? `<img src="${escapeHtml(withClientBase(base, a.cover))}" alt="${escapeHtml(a.title)}" loading="lazy" />` : ''}
				<span class="cg-date">${escapeHtml(fmtDate(a.publishAt))}</span>
			</div>
			<div class="cg-body">
				<h3 class="cg-title">${escapeHtml(a.title)}</h3>
				<p class="cg-summary">${escapeHtml(a.summary ?? '暂无描述')}</p>
				${a.tags?.length ? `<div class="cg-tags">${a.tags.map((t) => `<span class="cg-tag">${escapeHtml(t)}</span>`).join('')}</div>` : ''}
			</div>
		</a>`;

	const readArticles = (el: HTMLElement): GridArticle[] => {
		const raw = el.getAttribute('articles');
		if (!raw) return [];
		try {
			const parsed = JSON.parse(raw);
			return Array.isArray(parsed) ? (parsed as GridArticle[]) : [];
		} catch {
			return [];
		}
	};

	const sortDesc = (list: GridArticle[]): GridArticle[] =>
		[...list].sort((a, b) => new Date(b.publishAt).valueOf() - new Date(a.publishAt).valueOf());

	class CentralLinkGrid extends HTMLElement {
		static get observedAttributes(): string[] {
			return ['articles'];
		}

		attributeChangedCallback(name: string, _old: string | null, value: string | null): void {
			if (name !== 'articles') return;
			const grid = this.querySelector<HTMLElement>('.cg-grid');
			const empty = this.querySelector<HTMLElement>('.cg-empty');
			if (!grid || !empty) return;
			const articles = sortDesc(readArticles(this));
			empty.hidden = articles.length > 0;
			grid.hidden = articles.length === 0;
			if (articles.length) {
				const base = this.dataset.base || '/';
				grid.innerHTML = articles.map((article) => cardHtml(article, base)).join('');
			}
		}
	}

	if (!customElements.get('central-link-grid')) {
		customElements.define('central-link-grid', CentralLinkGrid);
	}
</script>
