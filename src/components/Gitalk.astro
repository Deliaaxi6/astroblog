---
import { site } from '../lib/site';

interface Props {
	pageId?: string;
}

const { pageId } = Astro.props;
const cfg = site.gitalk;
const enabled = !!(cfg.clientID && cfg.clientSecret && cfg.repo && cfg.owner && cfg.admin.length);
---

<section class="comments glass" id="comments">
	<h3 class="cm-title">评论区</h3>
	{
		enabled ? (
			<div id="gitalk-container"></div>
		) : (
			<p class="cm-tip">
					评论功能已停用：OAuth Secret 不应写入前端源码。启用前请接入服务端 OAuth 代理。
			</p>
		)
	}
</section>

{
	enabled && (
		<script define:vars={{ cfg, pageId }}>
			const cfg = __cfg;
			const pageId = __pageId;
			const container = document.getElementById('gitalk-container');
			if (container && !('Gitalk' in window)) {
				const link = document.createElement('link');
				link.rel = 'stylesheet';
				link.href = 'https://cdn.jsdelivr.net/npm/gitalk@1/dist/gitalk.css';
				document.head.appendChild(link);
				const script = document.createElement('script');
				script.src = 'https://cdn.jsdelivr.net/npm/gitalk@1/dist/gitalk.min.js';
				script.onload = function () {
					new window.Gitalk({
						clientID: cfg.clientID,
						clientSecret: cfg.clientSecret,
						repo: cfg.repo,
						owner: cfg.owner,
						admin: cfg.admin,
						id: pageId || location.pathname.replace(/\/+$/, '') || 'home',
						distractionFreeMode: false,
					}).render('gitalk-container');
				};
				document.head.appendChild(script);
			} else if (container && window.Gitalk) {
				new window.Gitalk({
					clientID: cfg.clientID,
					clientSecret: cfg.clientSecret,
					repo: cfg.repo,
					owner: cfg.owner,
					admin: cfg.admin,
					id: pageId || location.pathname.replace(/\/+$/, '') || 'home',
					distractionFreeMode: false,
				}).render('gitalk-container');
			}
		</script>
	)
}

<style>
	.comments {
		margin-top: 40px;
		padding: 28px;
		border-radius: 20px;
	}
	.cm-title {
		font-size: 18px;
		font-weight: 900;
		margin-bottom: 20px;
		letter-spacing: 0.05em;
	}
	.cm-tip {
		font-size: 13px;
		color: var(--text-mute);
		line-height: 1.8;
	}
	.cm-tip code {
		background: rgba(194, 65, 12, 0.1);
		color: var(--indigo-light);
		padding: 2px 6px;
		border-radius: 6px;
		font-size: 12px;
	}
</style>
