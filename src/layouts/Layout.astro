---
interface Props {
	title?: string;
	description?: string;
	cover?: string;
}

import Background from '../components/Background.astro';
import { site as siteConfig, withBase } from '../lib/site';
import '../styles/global.css';

const { title = '纸上拾光', description = '用 Astro 构建的个人博客', cover } = Astro.props;
const site = siteConfig.url;
const coverUrl = cover
	? cover.startsWith('http')
		? cover
		: new URL(withBase(cover), site).href
	: undefined;
const homePath = withBase('/');
const blogPath = withBase('/blog');
const momentsPath = withBase('/moments');
const photowallPath = withBase('/photowall');
const friendsPath = withBase('/friends');
const projectsPath = withBase('/projects');
const timelinePath = withBase('/timeline');
const aboutPath = withBase('/about');
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
		<link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url.href} />
		<meta property="og:site_name" content="纸上拾光" />
		<meta name="twitter:card" content="summary" />
		{coverUrl && <meta property="og:image" content={coverUrl} />}
		<link rel="canonical" href={Astro.url.href} />
		<link rel="preconnect" href="https://bu.dusays.com" crossorigin />
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'WebSite',
			name: '纸上拾光',
			url: site,
			description,
		})} />
		<slot name="head" />
		<script is:inline>
			(() => {
				try {
					if (!sessionStorage.getItem('navPlayed')) {
						sessionStorage.setItem('navPlayed', '1');
						document.documentElement.classList.add('nav-anim');
					}
				} catch (e) {
					/* noop */
				}
			})();
		</script>
		<script is:inline>
			(() => {
				try {
					const t = localStorage.getItem('theme') || 'dark';
					document.documentElement.setAttribute('data-theme', t);
				} catch (e) {
					/* noop */
				}
			})();
		</script>
	</head>
	<body class:list={{ home: Astro.url.pathname === homePath }}>
		<Background />
		<header id="navbar">
			<a class="brand" href={homePath}><span class="mark"></span>纸上拾光</a>
			<nav class="nav-links">
				<a href={homePath} class:list={{ active: Astro.url.pathname === homePath }}>首页</a>
				<a
					href={blogPath}
					class:list={{ active: Astro.url.pathname.startsWith(blogPath) }}>文章</a>
				<a
					href={momentsPath}
					class:list={{ active: Astro.url.pathname.startsWith(momentsPath) }}>说说</a>
				<a
					href={photowallPath}
					class:list={{ active: Astro.url.pathname.startsWith(photowallPath) }}>画廊</a>
				<a
					href={friendsPath}
					class:list={{ active: Astro.url.pathname.startsWith(friendsPath) }}>友链</a>
				<a
					href={projectsPath}
					class:list={{ active: Astro.url.pathname.startsWith(projectsPath) }}>项目</a>
				<a
					href={timelinePath}
					class:list={{ active: Astro.url.pathname.startsWith(timelinePath) }}>归档</a>
				<a
					href={aboutPath}
					class:list={{ active: Astro.url.pathname.startsWith(aboutPath) }}>关于</a>
			</nav>
		</header>
		<main class="container">
			<slot />
			<footer class="site-footer">
				© {new Date().getFullYear()} 纸上拾光 · Powered by Astro
			</footer>
		</main>
		<div id="toast"></div>
		<script>
			const lastY = { v: 0 };
			const nav = document.getElementById('navbar');
			const applyNavState = () => {
				const y = window.scrollY;
				nav.classList.toggle('scrolled', y > 80);
				if (y > lastY.v && y > 80) {
					nav.classList.add('hidden');
				} else {
					nav.classList.remove('hidden');
				}
				lastY.v = y;
			};
			window.addEventListener('scroll', applyNavState, { passive: true });
			applyNavState();
		</script>
	</body>
</html>
