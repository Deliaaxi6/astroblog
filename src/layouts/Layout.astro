---
interface Props {
	title?: string;
	description?: string;
	cover?: string;
}

const { title = '纸上拾光', description = '用 Astro 构建的个人博客', cover } = Astro.props;
const site = import.meta.env.SITE || 'http://localhost:4321';
const coverUrl = cover
	? cover.startsWith('http')
		? cover
		: new URL(cover, site).href
	: undefined;
import Background from '../components/Background.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url.href} />
		<meta property="og:site_name" content="纸上拾光" />
		<meta name="twitter:card" content="summary" />
		{coverUrl && <meta property="og:image" content={coverUrl} />}
		<link rel="canonical" href={Astro.url.href} />
		<link rel="preconnect" href="https://bu.dusays.com" crossorigin />
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'WebSite',
			name: '纸上拾光',
			url: site,
			description,
		})} />
		<slot name="head" />
		<script is:inline>
			(() => {
				try {
					const t = localStorage.getItem('theme') || 'dark';
					document.documentElement.setAttribute('data-theme', t);
				} catch (e) {
					/* noop */
				}
			})();
		</script>
	</head>
	<body>
		<Background />
		<header id="navbar">
			<a class="brand" href="/"><span class="mark"></span>纸上拾光</a>
			<nav class="nav-links">
				<a href="/" class:list={{ active: Astro.url.pathname === '/' }}>首页</a>
				<a
					href="/blog"
					class:list={{ active: Astro.url.pathname.startsWith('/blog') }}>文章</a>
				<a
					href="/moments"
					class:list={{ active: Astro.url.pathname.startsWith('/moments') }}>说说</a>
				<a
					href="/photowall"
					class:list={{ active: Astro.url.pathname.startsWith('/photowall') }}>画廊</a>
				<a
					href="/friends"
					class:list={{ active: Astro.url.pathname.startsWith('/friends') }}>友链</a>
				<a
					href="/projects"
					class:list={{ active: Astro.url.pathname.startsWith('/projects') }}>项目</a>
				<a
					href="/timeline"
					class:list={{ active: Astro.url.pathname.startsWith('/timeline') }}>归档</a>
				<a
					href="/about"
					class:list={{ active: Astro.url.pathname.startsWith('/about') }}>关于</a>
			</nav>
		</header>
		<main class="container">
			<slot />
			<footer class="site-footer">
				© {new Date().getFullYear()} 纸上拾光 · Powered by Astro · <span id="uptime"></span>
			</footer>
		</main>
		<div id="toast"></div>
		<script define:vars={{ buildStamp: new Date().toISOString() }}>
			const BUILD = new Date(buildStamp).getTime();
			function tickUptime() {
				const el = document.getElementById('uptime');
				if (!el) return;
				const diff = Math.max(0, Date.now() - BUILD);
				const d = Math.floor(diff / 86400000);
				const h = Math.floor((diff % 86400000) / 3600000);
				el.textContent = '运行 ' + d + ' 天 ' + h + ' 小时';
			}
			tickUptime();
			setInterval(tickUptime, 60000);
			const lastY = { v: 0 };
			const nav = document.getElementById('navbar');
			window.addEventListener(
				'scroll',
				() => {
					const y = window.scrollY;
					if (y > lastY.v && y > 80) {
						nav.classList.add('hidden');
					} else {
						nav.classList.remove('hidden');
					}
					lastY.v = y;
				},
				{ passive: true }
			);
		</script>
	</body>
</html>