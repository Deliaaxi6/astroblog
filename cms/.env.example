# CMS 管理接口认证（请使用随机生成的长字符串）
CMS_API_KEY=replace_with_a_long_random_value
# 需要跨域访问管理接口时填写，多个来源用逗号分隔；纯本机同源管理可留空
CMS_ALLOWED_ORIGINS=http://localhost:4321

# ImageKit 凭证（复制本文件为 .env 后填写）
# 获取方式见 README：ImageKit Dashboard → Developer options → API keys
IMAGEKIT_PRIVATE_KEY=private_your_private_key
IMAGEKIT_PUBLIC_KEY=public_your_public_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_url_endpoint_id
